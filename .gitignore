# ===========================
# XAMPP / PHP Project Ignore
# ===========================

# Ignore XAMPP temporary and system files
xampp/
htdocs/error.log
htdocs/access.log
*.bak
*.tmp
*.temp

# Ignore environment & config files (if any)
.env
config.php
db_config.php

# Ignore OS generated files
Thumbs.db
ehthumbs.db
.DS_Store
.DS_Store?
Icon?
._*
.Spotlight-V100
.Trashes

# Ignore Visual Studio Code settings
.vscode/
.history/
*.code-workspace

# Ignore node or composer dependencies (if you use them later)
node_modules/
vendor/

# Ignore PHPStorm / IDE cache
.idea/
.cache/

# Ignore Backup or Exported Files
*.sql
*.zip
*.rar
*.7z
*.tar.gz

# Ignore Logs
logs/
*.log

# Ignore any temporary upload files
uploads/tmp/
temp/
